!resources/documents/作业模板/.gitkeep
!resources/documents/实验指导书/
!resources/documents/实验指导书/.gitkeep
!resources/videos/
!resources/videos/课程录像/
!resources/videos/课程录像/.gitkeep
!resources/videos/实验演示/
!resources/videos/实验演示/.gitkeep
!resources/videos/其他视频/
!resources/videos/其他视频/.gitkeep
!resources/images/
!resources/images/图片素材/
!resources/images/图片素材/.gitkeep
!resources/images/课程图片/
!resources/images/课程图片/.gitkeep
!resources/archives/
