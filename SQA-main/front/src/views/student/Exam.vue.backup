<template>
  <div class="exam-container">
    <el-card shadow="hover">
      <template #header>
        <div class="card-header">
          <span>📝 我的考试</span>
        </div>
      </template>

      <el-tabs v-model="activeTab">
        <el-tab-pane label="待考试" name="upcoming">
          <el-table :data="upcomingExams" stripe v-loading="loading" element-loading-text="加载考试数据中...">
            <el-table-column prop="title" label="考试名称" min-width="200"/>
            <el-table-column prop="courseName" label="课程" width="150"/>
            <el-table-column prop="duration" label="时长(分钟)" width="100"/>
            <el-table-column prop="totalScore" label="总分" width="80"/>
            <el-table-column prop="startTime" label="开始时间" width="180"/>
            <el-table-column prop="endTime" label="结束时间" width="180"/>
            <el-table-column label="操作" width="120" fixed="right">
              <template #default="{ row }">
                <el-button type="primary" size="small" @click="startExam(row)">
                  开始考试
                </el-button>
              </template>
            </el-table-column>
          </el-table>
        </el-tab-pane>

        <el-tab-pane label="考试记录" name="history">
          <el-table :data="examHistory" stripe v-loading="loading" element-loading-text="加载考试记录中...">
            <el-table-column prop="title" label="考试名称" min-width="200"/>
            <el-table-column prop="courseName" label="课程" width="150"/>
            <el-table-column prop="submitTime" label="提交时间" width="180"/>
            <el-table-column prop="objectiveScore" label="客观题" width="100"/>
            <el-table-column prop="subjectiveScore" label="主观题" width="100"/>
            <el-table-column prop="totalScore" label="总分" width="80"/>
            <el-table-column label="状态" width="100">
              <template #default="{ row }">
                <el-tag :type="getStatusType(row.status)">{{ getStatusText(row.status) }}</el-tag>
              </template>
            </el-table-column>
            <el-table-column label="操作" width="120" fixed="right">
              <template #default="{ row }">
                <el-button type="success" size="small" @click="viewResult(row)">
                  查看结果
                </el-button>
              </template>
            </el-table-column>
          </el-table>
        </el-tab-pane>
      </el-tabs>
    </el-card>

    <!-- 考试对话框 -->
    <el-dialog v-model="examDialogVisible" title="在线考试" width="90%" :close-on-click-modal="false">
      <div v-if="currentExam" class="exam-content">
        <el-alert type="info" :closable="false" style="margin-bottom: 20px;">
          <template #title>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span>{{ currentExam.title }}</span>
              <span style="font-size: 18px; font-weight: bold; color: var(--accent-red);">
                剩余时间: {{ remainingTime }}
              </span>
            </div>
          </template>
        </el-alert>

        <div v-for="(question, index) in questions" :key="question.id" class="question-item">
          <div class="question-header">
            <span class="question-number">第{{ index + 1 }}题</span>
            <el-tag :type="getQuestionTypeTag(question.questionType)">{{ getQuestionTypeName(question.questionType) }}</el-tag>
            <span class="question-score">{{ question.score }}分</span>
          </div>
          <div class="question-content">{{ question.content }}</div>
          
          <!-- 选择题 -->
          <el-radio-group v-if="question.questionType === 'single_choice'" v-model="answers[question.id]">
            <el-radio v-for="option in question.options" :key="option" :label="option">{{ option }}</el-radio>
          </el-radio-group>
          
          <!-- 多选题 -->
          <el-checkbox-group v-if="question.questionType === 'multiple_choice'" v-model="answers[question.id]">
            <el-checkbox v-for="option in question.options" :key="option" :label="option">{{ option }}</el-checkbox>
          </el-checkbox-group>
          
          <!-- 判断题 -->
          <el-radio-group v-if="question.questionType === 'true_false'" v-model="answers[question.id]">
            <el-radio label="对">对</el-radio>
            <el-radio label="错">错</el-radio>
          </el-radio-group>
          
          <!-- 主观题 -->
          <el-input 
            v-if="['fill_blank', 'short_answer', 'programming'].includes(question.questionType)"
            v-model="answers[question.id]"
            type="textarea"
            :rows="question.questionType === 'programming' ? 10 : 4"
            placeholder="请输入答案..."
          />
        </div>
      </div>

      <template #footer>
        <el-button @click="examDialogVisible = false">取消</el-button>
        <el-button type="primary" @click="submitExam">提交试卷</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, onMounted, onUnmounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import examApi from '@/api/exam'

const activeTab = ref('upcoming')
const upcomingExams = ref([])
const examHistory = ref([])
const examDialogVisible = ref(false)
const currentExam = ref(null)
const studentExamId = ref(null)
const questions = ref([])
const answers = ref({})
const remainingTime = ref('00:00:00')
let timer = null

onMounted(() => {
  loadExams()
  loadHistory()
})

onUnmounted(() => {
  if (timer) clearInterval(timer)
})

const loadExams = async () => {
  loading.value = true
  try {
    // 获取学生的课程,然后获取所有课程的考试
    const { useUserStore } = await import('@/stores/user')
    const { getMyCourses } = await import('@/api/course')
    const userStore = useUserStore()
    const studentId = userStore.userInfo.id || 1
    
    const courseRes = await getMyCourses(studentId)
    const courses = courseRes.data || []
    
    if (courses.length === 0) {
      ElMessage.warning({ message: '暂无课程,无法加载考试', duration: 3000 })
      return
    }
    
    let allExams = []
    for (const course of courses) {
      try {
        const res = await examApi.getUpcomingExams(course.id)
        if (res.code === 200 && res.data) {
          allExams = allExams.concat(res.data.map(exam => ({
            ...exam,
            courseName: course.name || course.courseName
          })))
        }
      } catch (e) {
        console.error(`加载课程${course.id}的考试失败:`, e)
      }
    }
    upcomingExams.value = allExams
  } catch (error) {
    console.error('加载考试列表失败:', error)
    ElMessage.error({ message: '加载考试列表失败', duration: 3000 })
  } finally {
    loading.value = false
  }
}

const loadHistory = async () => {
  loading.value = true
  try {
    const { useUserStore } = await import('@/stores/user')
    const userStore = useUserStore()
    const studentId = userStore.userInfo.id || 1
    const res = await examApi.getExamHistory(studentId)
    if (res.code === 200) {
      examHistory.value = res.data || []
    }
  } catch (error) {
    console.error('加载考试记录失败:', error)
    ElMessage.error({ message: '加载考试记录失败', duration: 3000 })
  } finally {
    loading.value = false
  }
}

const startExam = async (exam) => {
  try {
    await ElMessageBox.confirm('确定开始考试吗?考试开始后将无法退出!', '提示', {
      confirmButtonText: '开始考试',
      cancelButtonText: '取消',
      type: 'warning'
    })
    
    const res = await examApi.startExam(exam.id)
    studentExamId.value = res.data.id
    currentExam.value = exam
    
    // 加载试题
    const questionsRes = await examApi.getExamQuestions(exam.id)
    questions.value = questionsRes.data || []
    
    // 初始化答案
    answers.value = {}
    questions.value.forEach(q => {
      answers.value[q.id] = q.questionType === 'multiple_choice' ? [] : ''
    })
    
    examDialogVisible.value = true
    startTimer(exam.duration)
  } catch (error) {
    if (error !== 'cancel') {
      ElMessage.error({ message: '开始考试失败', duration: 3000 })
    }
  }
}

const startTimer = (duration) => {
  let seconds = duration * 60
  
  const updateTimer = () => {
    const hours = Math.floor(seconds / 3600)
    const minutes = Math.floor((seconds % 3600) / 60)
    const secs = seconds % 60
    remainingTime.value = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}`
    
    if (seconds <= 0) {
      clearInterval(timer)
      ElMessage.warning({ message: '考试时间到,自动提交!', duration: 3000 })
      submitExam()
    }
    seconds--
  }
  
  updateTimer()
  timer = setInterval(updateTimer, 1000)
}

const submitExam = async () => {
  try {
    await examApi.submitExam(studentExamId.value, answers.value)
    ElMessage.success({ message: '提交成功!', duration: 3000 })
    examDialogVisible.value = false
    if (timer) clearInterval(timer)
    loadHistory()
  } catch (error) {
    ElMessage.error({ message: '提交失败', duration: 3000 })
  }
}

const viewResult = (row) => {
  // TODO: 查看考试结果详情
  ElMessage.info({ message: '查看考试结果功能开发中...', duration: 3000 })
}

const getStatusType = (status) => {
  const map = {
    'in_progress': 'warning',
    'submitted': 'info',
    'graded': 'success'
  }
  return map[status] || 'info'
}

const getStatusText = (status) => {
  const map = {
    'in_progress': '进行中',
    'submitted': '已提交',
    'graded': '已批改'
  }
  return map[status] || status
}

const getQuestionTypeTag = (type) => {
  const map = {
    'single_choice': '',
    'multiple_choice': 'warning',
    'true_false': 'success',
    'fill_blank': 'info',
    'short_answer': 'info',
    'programming': 'danger'
  }
  return map[type]
}

const getQuestionTypeName = (type) => {
  const map = {
    'single_choice': '单选题',
    'multiple_choice': '多选题',
    'true_false': '判断题',
    'fill_blank': '填空题',
    'short_answer': '简答题',
    'programming': '编程题'
  }
  return map[type] || type
}
</script>

<style scoped>
.exam-container {
  padding: 20px;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18px;
  font-weight: 600;
}

.exam-content {
  max-height: 70vh;
  overflow-y: auto;
  padding: 10px;
}

.question-item {
  margin-bottom: 30px;
  padding: 20px;
  background: var(--bg-secondary);
  border-radius: 8px;
  border: 1px solid var(--border);
}

.question-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
}

.question-number {
  font-size: 16px;
  font-weight: 600;
  color: var(--accent-cyan);
}

.question-score {
  margin-left: auto;
  color: var(--accent-orange);
  font-weight: 600;
}

.question-content {
  font-size: 15px;
  line-height: 1.8;
  margin-bottom: 15px;
  color: var(--text-primary);
}

.el-radio-group, .el-checkbox-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
</style>
